# OpenAI API Key (Required for live LLM responses)
OPENAI_API_KEY=your_openai_api_key_here

# OpenAI Model configuration
OPENAI_MODEL=gpt-4o-mini
OPENAI_TEMPERATURE=0.7

# Server configuration
HOST=127.0.0.1
PORT=8000
DEBUG=True
ENVIRONMENT=development

CHROMA_HOST=
CHROMA_API_KEY=
CHROMA_TENANT=
CHROMA_DATABASE=Poppy

# Wompi (Sandbox: https://sandbox.wompi.co/v1 | Production: https://production.wompi.co/v1)
WOMPI_PUBLIC_KEY=
WOMPI_PRIVATE_KEY=
WOMPI_INTEGRITY_SECRET=
WOMPI_EVENTS_SECRET=
WOMPI_BASE_URL=https://sandbox.wompi.co/v1
